{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(curl -s http://127.0.0.1:8000/*)"
    ],
    "ask": [
      "Bash(python:*)",
      "Bash(pip install:*)",
      "Bash(docker:*)"
    ],
    "deny": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Read(./.env)",
      "Edit(./.env)"
    ]
  }
}
